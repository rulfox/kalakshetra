# Base URL of the Spring Boot backend (server-side and client-side reads).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# This site's own public URL — used for canonical links, sitemap, and metadataBase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The S3 bucket's (or CloudFront's) public base URL, so next/image is allowed to optimize
# images served from it. Leave unset until the AWS bucket exists (backend/docs/aws-setup.md).
NEXT_PUBLIC_S3_PUBLIC_BASE_URL=

# Shared secret the backend must send to POST /api/revalidate — must match the backend's
# NEXTJS_REVALIDATE_SECRET.
REVALIDATE_SECRET=change-me
